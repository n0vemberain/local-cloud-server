{
  "name": "local-cloud-server",
  "productName": "Local Cloud Server",
  "version": "1.0.0",
  "description": "MacBook Local Cloud Server Application with Local Wi-Fi & Remote Access",
  "main": "main.js",
  "type": "module",
  "scripts": {
    "start": "electron .",
    "build:dmg": "electron-builder --mac dmg --arm64 -c.mac.identity=null",
    "build:universal": "electron-builder --mac dmg --universal -c.mac.identity=null",
    "test": "node tests/run-all-tests.js"
  },
  "keywords": [
    "macOS",
    "local-server",
    "cloud",
    "wifi",
    "remote-access",
    "dmg"
  ],
  "author": "Fatin Ishraque",
  "license": "ISC",
  "devDependencies": {
    "electron": "^45.2.1",
    "electron-builder": "^26.18.0"
  },
  "dependencies": {
    "archiver": "^8.0.0",
    "cookie-parser": "^1.4.7",
    "express": "^5.3.0",
    "ffmpeg-static": "^5.3.0",
    "mime-types": "^3.0.2",
    "multer": "^2.5.0",
    "qrcode": "^1.5.4"
  },
  "build": {
    "appId": "com.fatinishraque.localcloudserver",
    "productName": "Local Cloud Server",
    "artifactName": "${productName}-${version}-macOS-${arch}.${ext}",
    "directories": {
      "output": "release"
    },
    "mac": {
      "category": "public.app-category.utilities",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        }
      ],
      "icon": "build/icon.icns",
      "identity": null,
      "hardenedRuntime": false,
      "gatekeeperAssess": false
    },
    "dmg": {
      "title": "Install Local Cloud Server",
      "contents": [
        {
          "x": 130,
          "y": 180,
          "type": "file"
        },
        {
          "x": 410,
          "y": 180,
          "type": "link",
          "path": "/Applications"
        }
      ],
      "window": {
        "width": 540,
        "height": 360
      }
    },
    "files": [
      "main.js",
      "preload.js",
      "renderer/**/*",
      "server/**/*",
      "public/**/*",
      "assets/**/*",
      "bin/**/*"
    ],
    "extraResources": [
      {
        "from": "bin",
        "to": "bin",
        "filter": [
          "**/*"
        ]
      }
    ],
    "asarUnpack": [
      "bin/**/*",
      "node_modules/ffmpeg-static/**/*"
    ]
  }
}
