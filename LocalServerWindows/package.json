{
  "name": "local-cloud-server",
  "productName": "Local Cloud Server",
  "version": "1.0.0",
  "description": "Windows Local Cloud Server Application with Local Wi-Fi & Remote Access",
  "main": "main.js",
  "type": "module",
  "scripts": {
    "start": "electron .",
    "build:win": "electron-builder --win nsis --x64",
    "build:portable": "electron-builder --win portable --x64",
    "build:all": "electron-builder --win nsis portable --x64",
    "test": "node tests/run-all-tests.js"
  },
  "keywords": [
    "windows",
    "local-server",
    "cloud",
    "wifi",
    "remote-access",
    "nsis",
    "installer"
  ],
  "author": "Fatin Ishraque",
  "license": "ISC",
  "devDependencies": {
    "electron": "^45.2.1",
    "electron-builder": "^26.18.0"
  },
  "dependencies": {
    "archiver": "^8.0.0",
    "cookie-parser": "^1.4.7",
    "express": "^5.3.0",
    "ffmpeg-static": "^5.3.0",
    "mime-types": "^3.0.2",
    "multer": "^2.5.0",
    "qrcode": "^1.5.4"
  },
  "build": {
    "appId": "com.fatinishraque.localcloudserver",
    "productName": "Local Cloud Server",
    "artifactName": "${productName}-${version}-Windows-${arch}.${ext}",
    "directories": {
      "output": "release"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "Local Cloud Server",
      "runAfterFinish": true,
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico"
    },
    "files": [
      "main.js",
      "preload.js",
      "renderer/**/*",
      "server/**/*",
      "public/**/*",
      "assets/**/*",
      "bin/**/*"
    ],
    "extraResources": [
      {
        "from": "bin",
        "to": "bin",
        "filter": [
          "**/*"
        ]
      }
    ],
    "asarUnpack": [
      "bin/**/*",
      "node_modules/ffmpeg-static/**/*"
    ]
  }
}
